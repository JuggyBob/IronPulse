<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_ironpulse"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/widget_streak_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="WORKOUT STREAK"
        android:textColor="#8B949E"
        android:textSize="8sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_streak_flame"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/widget_streak_flame"
        android:src="@drawable/widget_flame_alive" />

    <ViewFlipper
        android:id="@+id/widget_streak_flipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:autoStart="false"
        android:inAnimation="@anim/widget_streak_in"
        android:outAnimation="@anim/widget_streak_out">

        <TextView
            android:id="@+id/widget_streak_current_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#F0F6FC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_current_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#F0F6FC"
            android:textSize="28sp"
            android:textStyle="bold" />
    </ViewFlipper>

    <TextView
        android:id="@+id/widget_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="workout days"
        android:textColor="#8B949E"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_streak_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:text="Best: 0 workout days"
        android:textColor="#8B949E"
        android:textSize="8sp" />

</LinearLayout>
