<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_ironpulse"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_profile_initial"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_ironpulse"
            android:gravity="center"
            android:text="IP"
            android:textColor="#0D1117"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_profile_name"
                android:textColor="#F0F6FC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_profile_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_profile_subtitle"
                android:textColor="#8B949E"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_profile_weight" android:textColor="#8B949E" android:textSize="9sp" />
            <TextView android:id="@+id/widget_profile_weight_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F0F6FC" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_profile_height" android:textColor="#8B949E" android:textSize="9sp" />
            <TextView android:id="@+id/widget_profile_height_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F0F6FC" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_profile_bmi" android:textColor="#8B949E" android:textSize="9sp" />
            <TextView android:id="@+id/widget_profile_bmi_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F0F6FC" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
